{
  "name": "@hraness/slopcamera",
  "version": "3.2.6",
  "description": "A local visual studio for coding agents: author scenes, combine generated and recorded media, and export images, diagrams, animation, and video from retained sources.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/cli.ts",
    "./src/code/advanced.ts",
    "./src/code/index.ts",
    "./src/generate.ts",
    "./src/host-resources.ts",
    "./src/index.ts",
    "./src/operations.ts",
    "./src/vectorize/worker.ts",
    "./src/workflow.ts",
    "./apps/desktop/cli/main.ts"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": {
    "packages": [
      "apps/web",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/gateway-v4": "npm:@ai-sdk/gateway@^4.0.27",
      "@img/sharp-darwin-arm64": "0.35.3",
      "@img/sharp-libvips-darwin-arm64": "1.3.2",
      "@native-sdk/cli": "0.5.3",
      "@types/bun": "^1.3.14",
      "@types/node": "^24.10.0",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.3",
      "agent-browser": "0.32.3",
      "ai-v7": "npm:ai@^7.0.36",
      "chromium-bidi": "12.1.0",
      "eslint": "^9.39.2",
      "fast-check": "^4.8.0",
      "motion": "12.42.0",
      "@paper-design/shaders": "0.0.77",
      "playwright-core": "1.62.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "three": "0.183.2",
      "typescript": "^6.0.3",
      "vite": "^8.1.5",
      "zod": "^4.4.3"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/slopcamera.git"
  },
  "homepage": "https://slopcamera.com/",
  "bugs": {
    "url": "https://github.com/hraness/slopcamera/issues"
  },
  "keywords": [
    "ai-media-generation",
    "ai-video-generation",
    "video-generation",
    "video-editing",
    "image-generation",
    "screen-recording",
    "motion-graphics",
    "captions",
    "speech-generation",
    "transcription",
    "diagrams",
    "creative-coding",
    "coding-agents",
    "agent-skill",
    "mcp-server",
    "cli",
    "typescript",
    "bun",
    "local-first"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "import": "./dist/cli.js"
    },
    "./code": {
      "types": "./src/code/index.ts",
      "import": "./dist/code/index.js"
    },
    "./code/advanced": {
      "types": "./src/code/advanced.ts",
      "import": "./dist/code/advanced.js"
    },
    "./generate": {
      "types": "./src/generate.ts",
      "import": "./dist/generate.js"
    },
    "./host-resources": {
      "types": "./src/host-resources.ts",
      "import": "./dist/host-resources.js"
    },
    "./operations": {
      "types": "./src/operations.ts",
      "import": "./dist/operations.js"
    },
    "./workflow": {
      "types": "./src/workflow.ts",
      "import": "./dist/workflow.js"
    },
    "./scene": {
      "types": "./packages/scene/src/index.ts",
      "import": "./packages/scene/src/index.ts"
    },
    "./local/code": {
      "types": "./apps/desktop/code/public.ts",
      "import": "./apps/desktop/code/public.ts"
    },
    "./local/code/advanced": {
      "types": "./apps/desktop/code/advanced.ts",
      "import": "./apps/desktop/code/advanced.ts"
    },
    "./local/code/workflows": {
      "types": "./apps/desktop/workflows/index.ts",
      "import": "./apps/desktop/workflows/index.ts"
    },
    "./local/html-overlay": {
      "types": "./apps/desktop/html-overlay/index.ts",
      "import": "./apps/desktop/html-overlay/index.ts"
    }
  },
  "bin": {
    "slopcamera": "./apps/desktop/dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "apps/desktop/analysis/protocol.ts",
    "apps/desktop/capture/protocol.ts",
    "apps/desktop/application/**/*.ts",
    "!apps/desktop/application/**/*.test.ts",
    "!apps/desktop/application/**/*.testing.ts",
    "!apps/desktop/application/**/test-support.ts",
    "!apps/desktop/application/**/*test-support.ts",
    "apps/desktop/cli/**/*.ts",
    "apps/desktop/studio/**/*.ts",
    "!apps/desktop/studio/**/*.test.ts",
    "!apps/desktop/studio/**/qualify-*.ts",
    "apps/desktop/studio/**/*.py",
    "!apps/desktop/studio/**/test_*.py",
    "!apps/desktop/studio/**/qualify_*.py",
    "examples/studio/**/*.py",
    "examples/studio/**/*.json",
    "examples/studio/**/README.md",
    "docs/studio.md",
    "examples/studio/native-workflow.ts",
    "examples/studio/hybrid-scene.ts",
    "examples/html/*.html",
    "examples/html/*.json",
    "examples/studio/vgpu/heat-field.mjs",
    "apps/desktop/studio/assets/README.md",
    "!apps/desktop/cli/**/*.test.ts",
    "!apps/desktop/cli/build-compiled.ts",
    "!apps/desktop/cli/compiled-bootstrap.ts",
    "apps/desktop/code/**/*.ts",
    "!apps/desktop/code/**/*.test.ts",
    "!apps/desktop/code/**/*benchmark*.ts",
    "apps/desktop/contracts/**/*.ts",
    "!apps/desktop/contracts/**/*.test.ts",
    "apps/desktop/core/**/*.ts",
    "!apps/desktop/core/**/*.test.ts",
    "!apps/desktop/core/**/test-support.ts",
    "apps/desktop/dist/cli",
    "apps/desktop/html-overlay/**/*.ts",
    "!apps/desktop/html-overlay/**/*.test.ts",
    "!apps/desktop/html-overlay/**/*.testing.ts",
    "apps/desktop/workflows/**/*.ts",
    "!apps/desktop/workflows/**/*.test.ts",
    "packages/scene/src/**/*.ts",
    "!packages/scene/src/**/*.test.ts",
    "NOTICE.md",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/spatial-scene/test-fixture.ts",
    "src/assets/fonts/nebula-sans",
    "schema",
    "skills",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:sdk && bun run build:desktop && bun run build:web",
    "build:sdk": "bun -e 'await (await import(\"node:fs/promises\")).rm(\"./dist\", { recursive: true, force: true })' && bun build ./src/index.ts ./src/cli.ts ./src/code/index.ts ./src/code/advanced.ts ./src/generate.ts ./src/host-resources.ts ./src/operations.ts ./src/workflow.ts ./src/vectorize/worker.ts --outdir ./dist --root ./src --target bun --format esm --splitting --packages external",
    "build:desktop": "bun run build:desktop:cli && bun run build:desktop:frontend && bun run build:desktop:runtime",
    "build:desktop:cli": "bun -e 'await (await import(\"node:fs/promises\")).rm(\"./apps/desktop/dist/cli\", { recursive: true, force: true })' && bun build --target=bun --minify --sourcemap=none --packages external --external @hraness/slopcamera/cli apps/desktop/cli/main.ts --outdir apps/desktop/dist/cli",
    "build:desktop:frontend": "vite build --config apps/desktop/frontend/vite.config.ts && bun run check:desktop:direct-boundary",
    "build:desktop:runtime": "bun build --compile --minify --sourcemap=none apps/desktop/runtime/src/main.ts --outfile apps/desktop/runtime/dist/slopcamera-gateway && bun run check:desktop:direct-boundary",
    "build:web": "bun run --cwd apps/web build",
    "dev:frontend": "vite --config apps/desktop/frontend/vite.config.ts",
    "dev:direct": "vite --config apps/desktop/direct/vite.config.ts",
    "fuzz:direct": "bun run ./apps/desktop/direct/fuzz-browser.ts",
    "dev:desktop": "bun run build:desktop:runtime && bun run ./apps/desktop/runtime/run-native.ts dev",
    "typecheck": "bun run typecheck:sdk && bun run typecheck:desktop",
    "typecheck:sdk": "tsc --noEmit -p tsconfig.json",
    "typecheck:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "lint": "bun run lint:sdk && bun run lint:desktop",
    "lint:sdk": "eslint src packages/scene scripts",
    "lint:desktop": "eslint apps/desktop/contracts apps/desktop/core apps/desktop/application apps/desktop/code apps/desktop/workflows apps/desktop/html-overlay apps/desktop/cli apps/desktop/qualification apps/desktop/capture apps/desktop/analysis apps/desktop/runtime apps/desktop/frontend apps/desktop/direct apps/desktop/studio",
    "test": "bun run test:sdk && bun run test:desktop && bun run --cwd apps/web test",
    "test:sdk": "bun test ./src ./packages/scene",
    "test:desktop": "bun test ./apps/desktop/contracts ./apps/desktop/core ./apps/desktop/application ./apps/desktop/code ./apps/desktop/workflows ./apps/desktop/html-overlay ./apps/desktop/cli ./apps/desktop/capture ./apps/desktop/analysis ./apps/desktop/runtime ./apps/desktop/frontend ./apps/desktop/direct ./apps/desktop/studio",
    "test:desktop:macos": "bun run build:desktop:capture:macos && bun test ./apps/desktop/capture/interruption-state.macos.test.ts ./apps/desktop/capture/timeline-prepared.macos.test.ts ./apps/desktop/capture/controller-orchestration.macos.test.ts ./apps/desktop/capture/finalization-state.macos.test.ts ./apps/desktop/capture/start-coordinator.macos.test.ts ./apps/desktop/capture/recorder-single-flight.macos.test.ts ./apps/desktop/capture/native-interruptions.macos.test.ts && bun run build:desktop:analysis:macos && bun test ./apps/desktop/analysis && bun run ./apps/desktop/runtime/run-zig.ts build test -Dplatform=macos",
    "build:desktop:capture:macos": "bun run ./apps/desktop/capture/build.ts",
    "build:desktop:analysis:macos": "bun run ./apps/desktop/analysis/build.ts",
    "build:desktop:macos": "bun run build:desktop:capture:macos && bun run build:desktop:analysis:macos && bun run build:desktop:frontend && bun run build:desktop:runtime && bun run ./apps/desktop/runtime/run-zig.ts build -Dplatform=macos -Doptimize=ReleaseFast",
    "start:desktop:macos": "bun run build:desktop:capture:macos && bun run build:desktop:analysis:macos && bun run build:desktop:runtime && bun run ./apps/desktop/runtime/run-native.ts run",
    "package:desktop:macos": "bun run build:desktop:capture:macos && bun run build:desktop:analysis:macos && bun run build:desktop:frontend && bun run build:desktop:runtime && bun run ./apps/desktop/runtime/run-zig.ts build package -Dplatform=macos -Dpackage-target=macos && bun run ./apps/desktop/runtime/package-macos.ts",
    "build:cli:macos": "bun run ./apps/desktop/cli/build-compiled.ts",
    "test:cli:compiled:macos": "bun run build:cli:macos && SLOPCAMERA_RUN_COMPILED_CLI_SMOKE=1 bun test ./apps/desktop/cli/compiled-portable-surface.macos.test.ts",
    "test:html-overlay": "bun test ./apps/desktop/html-overlay ./apps/desktop/application/html-overlay-browser-runtime.test.ts ./apps/desktop/application/html-overlay-integrity.test.ts ./apps/desktop/application/operations/media/html-overlay.test.ts ./apps/desktop/cli/html-overlay-renderer.security.test.ts ./apps/desktop/cli/html-overlay-snapshot-scavenger.test.ts ./apps/desktop/cli/html-overlay-renderer.macos.test.ts",
    "qualify:spatial-scenes": "bun run ./apps/desktop/qualification/spatial-scenes.ts",
    "qualify:creative-scenes": "bun run ./apps/desktop/qualification/creative-render.ts",
    "qualify:saved-world": "bun run ./apps/desktop/qualification/world-render.ts",
    "qualify:spatial-project": "bun run ./apps/desktop/qualification/project.ts",
    "qualify:spatial-compositor": "bun run ./apps/desktop/qualification/spatial-compositor.ts",
    "test:html-overlay:browser:macos": "SLOPCAMERA_RUN_HTML_OVERLAY_RENDERER_SMOKE=1 bun test ./apps/desktop/cli/html-overlay-renderer.macos.test.ts",
    "test:html-overlay:libraries:macos": "SLOPCAMERA_RUN_HTML_OVERLAY_LIBRARY_SMOKE=1 bun test ./apps/desktop/cli/html-overlay-renderer.macos.test.ts",
    "test:html-overlay:operation:macos": "SLOPCAMERA_RUN_HTML_OVERLAY_OPERATION_SMOKE=1 bun test ./apps/desktop/application/operations/media/html-overlay.test.ts",
    "verify:html-overlay:macos": "bun run test:html-overlay:browser:macos && bun run test:html-overlay:libraries:macos && bun run test:html-overlay:operation:macos",
    "test:capture:hardware:macos": "bun test ./apps/desktop/capture/hardware-smoke.macos.test.ts",
    "doctor:macos": "native doctor --manifest apps/desktop/app.zon --strict",
    "benchmark:code-concurrency": "bun run ./apps/desktop/code/concurrency-benchmark.ts",
    "check:desktop:direct-boundary": "bun run ./apps/desktop/direct/check-production-boundary.ts",
    "verify:direct": "bun run ./apps/desktop/direct/verify-browser.ts",
    "check:release-workflows": "bun test ./scripts/release-workflow.test.ts ./scripts/github-release.test.ts",
    "check:schema": "bun run ./scripts/validate-schema.ts",
    "check:skill": "bun run ./scripts/validate-skill.ts",
    "check:standalone": "bun run ./scripts/check-standalone.ts",
    "test:vectorize:official": "bun run ./scripts/official-vectorizer-smoke.ts",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "check:sdk": "bun run typecheck:sdk && bun run lint:sdk && bun run build:sdk && bun run test:sdk && bun run check:release-workflows && bun run check:schema && bun run check:skill",
    "check:desktop": "bun run check:effect && bun run typecheck:desktop && bun run lint:desktop && bun run test:desktop && bun run build:desktop",
    "check:web": "bun run --cwd apps/web check",
    "kb:refresh": "bunx --bun github:hraness/kb#v0.15.2 refresh --root kb",
    "kb:check:lane": "bunx --bun github:hraness/kb#v0.15.2 check --root kb --no-catalog",
    "kb:check": "bunx --bun github:hraness/kb#v0.15.2 check --root kb && bunx --bun github:hraness/kb#v0.15.2 agents check --root kb --repo .",
    "kb:catalog": "bunx --bun github:hraness/kb#v0.15.2 catalog --root kb",
    "check": "bun run check:standalone && bun run check:sdk && bun run check:desktop && bun run check:web && bun run check:standalone && bun run test:package",
    "prepack": "bun run check",
    "check:effect": "bun run ./scripts/check-effect-policy.ts && bun test ./scripts/check-effect-architecture.test.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway-v4": "npm:@ai-sdk/gateway@^4.0.27",
    "@noble/hashes": "2.2.0",
    "@paper-design/shaders": "0.0.77",
    "@resvg/resvg-js": "2.6.2",
    "@vercel/blob": "2.8.0",
    "ai-v7": "npm:ai@^7.0.36",
    "chromium-bidi": "12.1.0",
    "effect": "3.22.1",
    "motion": "12.42.0",
    "playwright-core": "1.62.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.4",
    "three": "0.183.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "0.7.2",
    "@eslint/js": "^9.39.2",
    "@hraness/design-kit": "github:hraness/design-kit#v0.3.0",
    "@hraness/direct": "github:hraness/direct#v0.7.20",
    "@native-sdk/cli": "0.5.3",
    "@types/bun": "^1.3.14",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "agent-browser": "0.32.3",
    "ajv": "8.17.1",
    "eslint": "^9.39.2",
    "fast-check": "^4.8.0",
    "tldraw": "5.2.5",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.1.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
