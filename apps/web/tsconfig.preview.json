{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "site.test.ts",
    "scripts/build-site.ts",
    "scripts/site-contract.ts",
    "scripts/site-contract.test.ts",
    "scripts/site-css.test.ts",
    "scripts/site-template.test.ts",
    "scripts/site-copy-content.test.ts",
    "scripts/site-install.test.ts",
    "src/copy-command.ts",
    "src/copy-command.test.ts",
    "scripts/verify-site-shell.ts",
    "scripts/site-shell-browser-contract.ts",
    "scripts/site-shell-browser-contract.test.ts",
    "scripts/site-copy-browser-contract.ts",
    "scripts/site-copy-browser-contract.test.ts",
    "scripts/site-install-baseline.test.ts",
    "scripts/site-install-dom.ts",
    "scripts/verify-site-copy.ts",
    "scripts/verify-site-install-shell.ts",
    "src/site-shell.stylex.ts",
    "src/site-install.stylex.ts",
    "src/site-renderer.ts",
    "src/site-template.ts",
    "src/site-content.ts",
    "src/site-foundation.ts",
    "scripts/build-preview.ts",
    "scripts/preview-contract.ts",
    "scripts/preview-contract.test.ts",
    "scripts/preview-css.ts",
    "scripts/preview-css.test.ts",
    "scripts/preview-file.ts",
    "scripts/preview-file.test.ts",
    "scripts/verify-preview-layout.ts",
    "scripts/preview-layout.test.ts",
    "scripts/preview-browser-contract.ts",
    "scripts/preview-browser-protocol.ts",
    "scripts/preview-browser-protocol.test.ts",
    "scripts/preview-browser-driver.ts",
    "scripts/build-preview-browser-driver.ts",
    "src/preview-renderer.ts",
    "src/preview-foundation.ts",
    "src/preview.stylex.ts",
    "scripts/generate-icons.ts",
    "scripts/verify-site-marketing.ts",
    "scripts/site-marketing-browser-contract.ts",
    "scripts/site-marketing-browser-contract.test.ts",
    "scripts/lantern-material.test.ts",
    "scripts/site-marketing-font-diagnostic.ts",
    "scripts/site-marketing-font-diagnostic.test.ts"
  ]
}
